{
    parserClass='com.zephir.lang.core.parser.ZephirParser'
    parserUtilClass='com.zephir.lang.core.parser.manual.ZephirManualParseRules'

    extends='com.intellij.extapi.psi.ASTWrapperPsiElement'

    psiClassPrefix='Zephir'
    psiImplClassSuffix='Impl'
    psiPackage='com.zephir.lang.core.psi'
    psiImplPackage='com.zephir.lang.core.psi.impl'

    elementTypeHolderClass='com.zephir.lang.core.psi.ZephirTypes'
    elementTypeClass='com.zephir.lang.core.psi.ZephirElementType'
    tokenTypeClass='com.zephir.lang.core.psi.ZephirTokenType'
    // TODO(serghei): Do we need this?
    // Also see: https://github.com/JetBrains/gradle-grammar-kit-plugin/issues/3
    psiImplUtilClass='com.zephir.lang.core.psi.impl.ZephirPsiImplUtil'

    tokens = [
        // regex
        COMMENT            = 'regexp://.*'
        COMMENT_BLOCK      = 'regexp:(/\*([^*]+|[*]+[^/*])*[*]*\*/)'
        IDENTIFIER         = 'regexp:[_a-zA-Z][a-zA-Z0-9_]*'
        INTEGER            = 'regexp:([\-]?[0-9]+)|([\-]?[0][x][0-9A-Fa-f]+)'
        DOUBLE             = 'regexp:([\-]?[0-9]+[.][0-9]+)'
        SCHAR              = "regexp:(['] ([^'\\]|\\.)* ['])"
        STRING             = 'regexp:(["] ([^"\\]|\\.)* ["])'
        CBLOCK             = 'regexp:%[{]([^}]+|[}]+[^%{])*[}]%'

        // OOP Keywords
        INTERNAL           = 'internal'
        NAMESPACE          = 'namespace'
        USE                = 'use'
        AS                 = 'as'
        INTERFACE          = 'interface'
        TRAIT              = 'trait'
        READONLY           = 'readonly'
        CLASS              = 'class'
        FUNCTION           = 'function'
        EXTENDS            = 'extends'
        IMPLEMENTS         = 'implements'
        ABSTRACT           = 'abstract'
        FINAL              = 'final'
        PUBLIC             = 'public'
        PROTECTED          = 'protected'
        PRIVATE            = 'private'
        STATIC             = 'static'
        INLINE             = 'inline'
        DEPRECATED         = 'deprecated'

        // Types
        TYPE_VAR           = 'var'
        TYPE_VOID          = 'void'
        TYPE_INT           = 'int'
        TYPE_UINT          = 'uint'
        TYPE_LONG          = 'long'
        TYPE_ULONG         = 'ulong'
        TYPE_CHAR          = 'char'
        TYPE_UCHAR         = 'uchar'
        TYPE_DOUBLE        = 'double'
        TYPE_BOOL          = 'bool'
        TYPE_STRING        = 'string'
        TYPE_ARRAY         = 'array'
        TYPE_OBJECT        = 'object'
        TYPE_CALLABLE      = 'callable'
        TYPE_RESOURCE      = 'resource'
        TYPE_MIXED         = 'mixed'

        // Value Keywords
        NULL               = 'null'
        FALSE              = 'false'
        TRUE               = 'true'

        // Keywords
        LET                = 'let'
        ECHO               = 'echo'
        CONST              = 'const'
        IF                 = 'if'
        ELSE               = 'else'
        ELSEIF             = 'elseif'
        SWITCH             = 'switch'
        CASE               = 'case'
        DEFAULT            = 'default'
        DO                 = 'do'
        WHILE              = 'while'
        FOR                = 'for'
        LOOP               = 'loop'
        REVERSE            = 'reverse'
        BREAK              = 'break'
        CONTINUE           = 'continue'
        IN                 = 'in'
        NEW                = 'new'
        RETURN             = 'return'
        REQUIRE            = 'require'
        REQUIRE_ONCE       = 'require_once'
        YIELD              = 'yield'
        CLONE              = 'clone'
        EMPTY              = 'empty'
        TYPEOF             = 'typeof'
        INSTANCEOF         = 'instanceof'
        LIKELY             = 'likely'
        UNLIKELY           = 'unlikely'
        ISSET              = 'isset'
        UNSET              = 'unset'
        THROW              = 'throw'
        FETCH              = 'fetch'
        TRY                = 'try'
        CATCH              = 'catch'

        // Other
        PARENTHESES_OPEN   = '('
        PARENTHESES_CLOSE  = ')'
        BRACKET_OPEN       = '{'
        BRACKET_CLOSE      = '}'
        SBRACKET_OPEN      = '['
        SBRACKET_CLOSE     = ']'
        AT                 = '@'
        NOT                = '!'
        AND                = '&&'
        OR                 = '||'
        BITWISE_AND        = '&'
        BITWISE_OR         = '|'
        BITWISE_XOR        = '^'
        BITWISE_SHIFTLEFT  = '<<'
        BITWISE_SHIFTRIGHT = '>>'
        ASSIGN             = '='
        ADDASSIGN          = '+='
        SUBASSIGN          = '-='
        MULASSIGN          = '*='
        EXPASSIGN          = '**='
        DIVASSIGN          = '/='
        MODASSIGN          = '%='
        CONCATASSIGN       = '.='
        EQUALS             = '=='
        NOTEQUALS          = '!='
        IDENTICAL          = '==='
        NOTIDENTICAL       = '!=='
        LESSEQUAL          = '<='
        GREATEREQUAL       = '>='
        LESS               = '<'
        GREATER            = '>'
        ARROW              = '->'
        DOUBLECOLON        = '::'
        DOT                = '.'
        ELLIPSIS           = '...'
        ADD                = '+'
        SUB                = '-'
        MUL                = '*'
        EXP                = '**'
        DIV                = '/'
        MOD                = '%'
        INCR               = '++'
        DECR               = '--'
        COLON              = ':'
        DOTCOMMA           = ';'
        COMMA              = ','
        QUESTION           = '?'
        ATTRIBUTE_OPEN     = '#['
        DOUBLEARROW        = '=>'
        IRANGE             = '..'
        AND_ASSIGN         = '&='
        OR_ASSIGN          = '|='
        XOR_ASSIGN         = '^='
        SHL_ASSIGN         = '<<='
        SHR_ASSIGN         = '>>='
        BITWISE_NOT        = '~'
        ISTRING            = 'regexp:~(["] ([^"\\]|\\.)* ["])'
    ]

    extends(".*Expr") = Expr
}

// This is the grammar of the Zephir language which is used by Grammar Kit
// to generate the parser and the PSI classes. Rule `FooBar` corresponds
// to `ZephirFooBar` PSI class.
//
// Naming convention:
//
//   * tokens are lowercase: for, if, identifier
//   * rules are PascalCase: TopStatement, ArrayAccess
//   * lexer rules are UPPER_CASE: TYPE_UINT, DOUBLECOLON

File ::= TopStatement*

CBlock ::= CBLOCK

private TopStatement ::= !<<eof>> TopStatementItem {pin=1 recoverWhile=TopStatementRecover}

private TopStatementItem ::= NamespaceStatement |
                             ImportStatement |
                             CBlock |
                             AttributedDeclaration |
                             Declaration |
                             <<skipDeclaration>>

private AttributedDeclaration ::= AttributeGroup+ Declaration {pin=1}

private TopStatementRecover ::= !('namespace' | 'use' | 'class' | 'interface' | 'trait' | 'abstract' | 'final' |
                                  'function' | '#[' | CBLOCK)

private Declaration ::= ClassDefinition |
                        InterfaceDefinition |
                        TraitDefinition |
                        FunctionDefinition

PhpReserved ::= '$resource' | '$namespace' | '$internal'

NamespaceStatement ::= 'namespace' ComplexId ';' {pin=1}

ImportStatement ::= 'use' ComplexId ('as' Id)? ';' {pin=1}

ClassDefinition ::= ClassModifier? 'class' Id SuperClass? ImplementsList? <<skipHeader>>? ClassBody {
    pin=2
    mixin="com.zephir.lang.core.psi.ZephirNamedElementMixin"
    implements="com.zephir.lang.core.psi.ZephirNamedElement"
}

TraitDefinition ::= 'trait' Id <<skipHeader>>? TraitBody {
    pin=1
    mixin="com.zephir.lang.core.psi.ZephirNamedElementMixin"
    implements="com.zephir.lang.core.psi.ZephirNamedElement"
}

TraitBody ::= '{' ClassMember* '}' {pin=1}

TraitUseStatement ::= 'use' ComplexIdList ';' {pin=1}

FunctionDefinition ::= 'function' Id ParameterList ReturnType? (CodeBlock | ';') {
    pin=1
    mixin="com.zephir.lang.core.psi.ZephirNamedElementMixin"
    implements="com.zephir.lang.core.psi.ZephirNamedElement"
}

private ClassModifier ::= 'abstract' | 'final'

SuperClass ::= 'extends' ComplexId {pin=1}
ImplementsList ::= 'implements' ComplexIdList {pin=1}
ClassBody ::= '{' ClassMember* '}' {pin=1}

private ClassMember ::= !'}' ClassMemberItem {pin=1 recoverWhile=MemberRecover}

private ClassMemberItem ::= AttributedMember |
                            ClassMemberDeclaration |
                            <<skipMember>>

private AttributedMember ::= AttributeGroup+ ClassMemberDeclaration {pin=1}

private ClassMemberDeclaration ::= TraitUseStatement |
                                   ConstantDefinition |
                                   PropertyDefinition |
                                   MethodDefinition

private MemberRecover ::= !('internal' | 'public' | 'protected' | 'private' | 'static' | 'inline' | 'deprecated' |
                            'abstract' | 'final' | 'readonly' | 'const' | 'function' | 'use' | '#[' | '}')

InterfaceDefinition ::= 'interface' Id SuperInterfaces? <<skipHeader>>? InterfaceBody {
    pin=1
    mixin="com.zephir.lang.core.psi.ZephirNamedElementMixin"
    implements="com.zephir.lang.core.psi.ZephirNamedElement"
}
SuperInterfaces ::= 'extends' ComplexIdList {pin=1}
InterfaceBody ::= '{' InterfaceMember* '}' {pin=1}

private InterfaceMember ::= !'}' InterfaceMemberItem {pin=1 recoverWhile=MemberRecover}

private InterfaceMemberItem ::= AttributedInterfaceMember |
                                InterfaceMemberDeclaration |
                                <<skipMember>>

private AttributedInterfaceMember ::= AttributeGroup+ InterfaceMemberDeclaration {pin=1}
private InterfaceMemberDeclaration ::= ConstantDefinition | InterfaceMethodDefinition

InterfaceMethodDefinition ::= MemberModifiers FUNCTION Id ParameterList ReturnType? ';' {
    pin=3
    mixin="com.zephir.lang.core.psi.ZephirNamedElementMixin"
    implements="com.zephir.lang.core.psi.ZephirNamedElement"
}

ConstantDefinition ::= 'const' Id DefaultValue? ';' {
    pin=2
    mixin="com.zephir.lang.core.psi.ZephirNamedElementMixin"
    implements="com.zephir.lang.core.psi.ZephirNamedElement"
}

PropertyDefinition ::= MemberModifiers !FUNCTION PropertyType? Id DefaultValue? MemberMetaAccess? ';' {
    pin=2
    mixin="com.zephir.lang.core.psi.ZephirNamedElementMixin"
    implements="com.zephir.lang.core.psi.ZephirNamedElement"
}

private PropertyType ::= '?' ValueType | UnionType | ValueType

private MemberMetaAccess ::= '{' (PropertyShortcut (',' PropertyShortcut)*)? '}' {pin=1}
PropertyShortcut ::= IDENTIFIER

MethodDefinition ::= MemberModifiers FUNCTION Id ParameterList ReturnType? (MethodBody | ';') {
    pin=3
    mixin="com.zephir.lang.core.psi.ZephirNamedElementMixin"
    implements="com.zephir.lang.core.psi.ZephirNamedElement"
}
MethodBody ::= CodeBlock

private ParameterList ::= '(' ParameterListItems ')' {pin=1}
private ParameterListItems ::= Arguments* {recoverWhile=ParameterListRecover}
private ParameterListRecover ::= !(')' | '{' | ';' | '->' | 'use')

MemberModifiers ::= MemberModifier+
MemberModifier ::= 'internal' | 'public' | 'protected' | 'private' | 'static' | 'inline' | 'deprecated' |
                   'abstract' | 'final' | 'readonly'

AttributeGroup ::= '#[' Attribute (',' Attribute)* ']' {pin=1}
Attribute ::= AttributeName AttributeArguments?
private AttributeArguments ::= '(' CallArgumentList ')' {pin=1}
AttributeName ::= ComplexId | 'deprecated' | 'final' | 'internal' | 'readonly' | 'static' | 'default' | 'case' |
                  'empty' | 'void' | 'reverse' | 'inline'

CodeBlock ::= '{' Statement* '}' {pin=1}

private Statement ::= StatementItem {recoverWhile=StatementRecover}
private StatementItem ::= Code | <<skipStatement>>
private StatementRecover ::= <<statementRecover>>

ReturnType ::= '->' (VoidReturnType | ReturnTypeItem ('|' ReturnTypeItem)*) {
    pin(".*")=1
    recoverWhile=ReturnTypeRecover
}
private ReturnTypeRecover ::= !('{' | ';' | '}' | 'internal' | 'public' | 'protected' | 'private' | 'static' | 'inline' |
                               'deprecated' | 'abstract' | 'final' | 'readonly' | 'const' | 'function' | 'use' | '#[' |
                               'class' | 'interface' | 'trait' | 'namespace')
private VoidReturnType ::= &'void' Type !('|' | '!')
private ReturnTypeItem ::= ReturnTypeMember | <<skipType>>
private ReturnTypeMember ::= !('<' '$') (CollectionType | ValueType '!'? | 'null' | 'false' | 'this')
CollectionType ::= '<' !'$' ComplexId '[' ']' '>'

UnionType ::= ValueType ('|' UnionTypeMember)+
private UnionTypeMember ::= ValueType | 'null' | 'false'

private ValueType ::= !('void' | '<' '$') Type

Arguments ::= AttributedArgument (',' AttributedArgument)* {pin(".*")=1}
private AttributedArgument ::= AttributeGroup* Argument
private ArgumentType ::= UnionType | ValueType
Argument ::= 'const'? ArgumentType? '!'? '...'? '&'? (PhpReserved | Id) DefaultValue? {pin=6}

DefaultValue ::= '=' Expr {pin=1}

Id ::= '$'?IDENTIFIER {
    mixin="com.zephir.lang.core.psi.ZephirIdMixin"
    implements="com.intellij.psi.PsiNameIdentifierOwner"
}

ComplexId ::= '$'? '\'? Id ('\' Id)* {pin(".*")=3}
ComplexIdList ::= ComplexId (',' ComplexId)* {pin(".*")=1}

Type ::= VoidType | ScalarType | ClassType | ResourceType
ScalarType ::= 'var' | NumberType | StringType | BoolType | 'array' | 'object' | 'callable' | 'resource' | 'mixed'

private StringType ::= 'string' | 'char' | 'uchar'
private BoolType ::= 'bool' | 'boolean'
private NumberType ::= IntType | DoubleType | 'uint' | 'long' | 'ulong'
private IntType ::= 'int' | 'integer'
private DoubleType ::= 'double' | 'float'
private ClassType ::= '<' (ComplexId | 'static') '>'
private ResourceType ::= '<' '$'ComplexId '>'
private VoidType ::= 'void'

Code ::= DeclarationStatement |
         LetStatement |
         CallStatement |
         ChainOfCallStatement |
         ControlStatement |
         LoopStatement |
         SwitchStatement |
         IfStatement |
         TryStatement |
         ReturnStatement |
         EchoStatement |
         ThrowStatement |
         RequireStatement |
         YieldStatement |
         UnsetStatement |
         EmptyStatement |
         CBlock

DeclarationStatement ::= Type DeclarationStatementElement (',' DeclarationStatementElement)* ';' {pin(".*")=1}

private DeclarationStatementElement ::= (Id | PhpReserved) DefaultValue?

LetStatement ::= 'let' ChangeVariableExpr (',' ChangeVariableExpr)* ';' {pin(".*")=1}

ChangeVariableExpr ::= AssignmentExpr | IncrementExpr | DestructureExpr

DestructureExpr ::= '[' DestructureSlot (',' DestructureSlot)* ']' '=' Expr {pin=1}
private DestructureSlot ::= Id?
AssignmentExpr ::= (Typecast | Type)? (Variable | ExplodedVariable | PhpReserved) ArrayAppendExpr? AssignmentOperator (Typecast | Type)?  (PhpReserved | Expr) { rightAssociative=true }

private ArrayAppendExpr ::= '[' ']'

AssignmentOperator ::= '=' | '+=' | '-=' | '*=' | '**=' | '/=' | '%=' | '.=' | '&=' | '|=' | '^=' | '<<=' | '>>='
Typecast ::= '(' ScalarType ')' | '<' ComplexId '>'

IncrementExpr ::= Variable IncrementOperator {rightAssociative=true}
IncrementOperator ::= '++' | '--'

CallStatement ::= CallExpr ';'

ControlStatement ::= ('continue' | 'break') ';' {pin=1}

LoopStatement ::= InfinityLoopStatement |
                   DoWhileLoopStatement |
                   WhileLoopStatement |
                   ForeachLoopStatement

InfinityLoopStatement ::= 'loop' CodeBlock {pin=1}

DoWhileLoopStatement ::= 'do' CodeBlock 'while' Expr ';' {pin=1}

WhileLoopStatement ::= 'while' Expr CodeBlock {pin=2}

ForeachLoopStatement ::= 'for' Id (',' Id)? 'in' 'reverse'? (PhpReserved | Expr) CodeBlock {pin=2}
UnsetStatement ::= 'unset' (Variable | '(' Variable ')') ';' {pin=1}

SwitchStatement ::= 'switch' Expr '{' CaseExpr*  '}' {pin=1}
StaticCallExpr ::= ((('{' Id '}') | 'static') '::') CallExpr {pin=1}

CaseExpr ::= ('case' Expr | 'default') ':' Statement* {pin=1}

IfStatement ::= 'if' ('likely' | 'unlikely')? Expr CodeBlock ElseifStatements* ElseStatement? {pin=1}
ElseifStatements ::= 'elseif' Expr CodeBlock {pin=1}
ElseStatement ::= 'else' CodeBlock {pin=1}

TryStatement ::= 'try' CodeBlock CatchBlock*  {pin=1}
CatchBlock ::= 'catch' ClassType? ComplexId (',' ComplexId)* CodeBlock {pin=3}

ReturnStatement ::= 'return' (RequireStatement | (Typecast? Expr? ';')) {pin=1}

EchoStatement ::= 'echo' Expr (',' Expr)* ';' {pin(".*")=1}

ThrowStatement ::= 'throw' Expr ';' {pin=1}
RequireStatement ::= RequireExpr ';' {pin=1}

EmptyStatement ::= ';'

YieldStatement ::= 'yield' (Expr (',' Expr)?)? ';' {pin=1}

private RequireExpr ::= ('require' | 'require_once') Expr

Expr ::= ArrowFunctionExpr |
         UnaryExpr |
         BitExpr |
         BoolGroupExpr |
         MathExpr |
         RangeExpr |
         BitwiseNotExpr |
         PrimaryGroupExpr |
         SpecialGroupExpr

private BoolGroupExpr ::= BoolExpr | ShortTernaryExpr | TernaryExpr | EmptyExpr | IssetExpr | FetchExpr | InstanceofExpr
private PrimaryGroupExpr ::= ChainOfCallExpr | StaticAccessExpr | StaticCallExpr | LiteralExpr | ParenExpr | PrecastExpr | CallbackExpr | CallExpr | MethodCallExpr | CloneExpr
private SpecialGroupExpr ::= NewExpr | TypeofExpr

ChainOfCallStatement ::= ChainOfCallExpr ;
ChainOfCallExpr ::= (ParenExpr '->') Expr

BitExpr ::= Expr BitOperator Expr
BitOperator ::= '&' | '|' | '^' | '>>' | '<<'

MathExpr ::= Expr MathOperator Expr
MathOperator ::= '+' | '-' | '*' | '**' | '/' | '%' | '.'

UnaryExpr ::= ('+' | '-' | '!') Expr
BitwiseNotExpr ::= '~' Expr
BoolExpr ::= Expr BoolOperator Expr
BoolOperator ::= '&&' | '||' | '>' | '<' | '==' | '>=' | '<=' | '===' | '!=' | '!=='

ArrowFunctionExpr ::= Id '=>' Expr {pin=2}
RangeExpr ::= Expr ('...' | '..') Expr
ShortTernaryExpr ::= Expr '?' ':' Expr {pin=2 rightAssociative=true}
TernaryExpr ::= Expr '?' Expr ':' Expr {pin=1}
StaticAccessExpr ::= 'static' '::' ('class' | Variable) !'('
LiteralExpr ::= Typecast? (Variable | scalar)
ParenExpr ::= '(' Expr ')' {pin=1}
PrecastExpr ::= '{' Expr '}' {pin=1}

EmptyExpr ::= 'empty' Expr {pin=1}
IssetExpr ::= 'isset' Expr {pin=1}
FetchExpr ::= 'fetch' Id ',' Expr {pin=2}
InstanceofExpr ::= Variable 'instanceof' InstanceofOperand {pin=2}
private InstanceofOperand ::= 'static' !'::' | Expr

CallExpr ::=  Expr CallTail ('->' Id CallTail)* ArrayAccess?
private CallTail ::= '(' CallArgumentList ')' {pin=1}
MethodCallExpr ::= Expr '->' Id CallTail ArrayAccess?
MagicCallExpr ::= '$'('clone' | 'fetch') '(' Arguments* ')'
CallbackExpr ::= 'function' ParameterList UseClause? ReturnType? CodeBlock {pin=2}
UseClause ::= 'use' '(' UseArguments? ')' {pin=1}
UseArguments ::= UseArgument (',' UseArgument)* {pin(".*")=1}
UseArgument ::= 'const'? '&'? Id {pin=3}
CloneExpr ::= 'clone' Variable

NewExpr ::= NewExprClassic | NewExprDynamic

private NewExprClassic ::= 'new' (ComplexId | 'static') ('(' CallArgumentList ')')? {pin=2}
private NewExprDynamic ::= 'new' '{' Expr '}' ('(' CallArgumentList ')')? {pin=2}

TypeofExpr ::= 'typeof' Expr {pin=1}

private CallArgumentList ::= CallArguments? {recoverWhile=CallArgumentsRecover}
private CallArgumentsRecover ::= !(')' | ';' | '{' | '}')

CallArguments ::= CallArgument (',' CallArgument)* {pin(".*")=1}

private CallArgument ::= NamedArgument | 'require'? Typecast? (PhpReserved | Expr)

NamedArgument ::= NamedArgumentName ':' Expr {pin=2}
NamedArgumentName ::= Id | 'null' | 'false' | 'true' | 'namespace' | 'use' | 'as' | 'interface' | 'class' | 'trait' |
                      'extends' | 'implements' | 'internal' | 'public' | 'protected' | 'private' | 'static' |
                      'inline' | 'deprecated' | 'final' | 'abstract' | 'readonly' | 'let' | 'echo' | 'const' |
                      'int' | 'uint' | 'long' | 'ulong' | 'char' | 'uchar' | 'string' | 'array' | 'var' |
                      'object' | 'callable' | 'resource' | 'mixed' | 'if' | 'else' | 'elseif' | 'do' | 'while' |
                      'for' | 'in' | 'new' | 'return' | 'require_once' | 'yield' | 'require' | 'clone' |
                      'empty' | 'void' | 'loop' | 'break' | 'continue' | 'typeof' | 'instanceof' | 'likely' |
                      'unlikely' | 'isset' | 'unset' | 'throw' | 'fetch' | 'switch' | 'case' | 'default' |
                      'reverse' | 'try' | 'catch'
private ScalarShort ::= STRING  | ISTRING | SCHAR | DOUBLE | INTEGER | ScalarValue

scalar ::= ScalarShort | ArrayValue
ScalarValue ::= 'null' | 'true' | 'false'

ArrayValue ::= '[' ArrayBody? ']' {pin=1}

private ArrayBody ::= ArrayItem (',' ArrayItem)* {pin(".*")=1}

ArrayItem ::= ArrayKeyValue | Expr
ArrayKeyValue ::= (ScalarShort | Expr) ':' Expr

Variable ::= ComplexId (PropertyAccess | ArrayAppendExpr |  ArrayAccess)*
ExplodedVariable ::= '{' Variable '}'

private PropertyAccess ::= ClassAccess | MemberAccess
private ClassAccess ::= '::' 'class' {pin=2}
private MemberAccess ::= ('::' | '->') (Variable | '{' (STRING | Id) '}' | MagicCallExpr) {pin=2}
private ArrayAccess ::= '[' (Expr | PhpReserved) ']' {pin=1}
